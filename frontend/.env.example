# In development, leave empty (Vite proxies /api, /socket.io, and /uploads to http://localhost:5000).
# In production on Vercel, set VITE_API_URL to your Render backend URL:
# e.g. VITE_API_URL=https://verimarket-backend.onrender.com/api
# and VITE_SOCKET_URL=https://verimarket-backend.onrender.com
VITE_API_URL=
VITE_SOCKET_URL=
# Display currency
VITE_CURRENCY=USD
VITE_LOCALE=en-US
